{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": { "DISABLE_TELEMETRY": "true" }
    },
    "elevenlabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${env:ELEVEN_LABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "assets/source/audio/elevenlabs/raw"
      }
    }
  }
}
