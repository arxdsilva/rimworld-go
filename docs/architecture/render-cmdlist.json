  {
   "dot": "violet",
   "title": "The key",
   "items": [
    "64 bits: pass 4 | layer 8 | sub 32 | seq 20",
    "pass orders render targets; layer is today's layer; seq makes every key unique",
    "sub is 0 when strict, the screen y when y-sorted, the state ID when binned"
   ]
  },
  {
   "dot": "cyan",
   "title": "Merge rules",
   "items": [
    "Adjacent commands merge when target, shader, four source sheets, blend and uniforms match",
    "A batch holds at most about 16k quads and never crosses a command entry",
    "Light rides in the vertices, so lit sprites from one sheet merge"
   ]
  },
