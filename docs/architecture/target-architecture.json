 "cards": [
  {
   "dot": "emerald",
   "title": "Added in Part E",
   "items": [
    "game/sched: systems with declared reads and writes, a Kahn order and per-entity stagger (ADR 0001)",
    "domain/sim/event: event columns, the spine and the saved timer heap (ADR 0003)",
    "platform/pool: one fixed 8-lane pool behind a Pool port, built in compose (ADR 0002)",
    "render/cmdlist: layers emit keyed commands, merged into few draws (ADR 0004)",
    "game/savejob: snapshot at the tick boundary, encode and write on a worker (GAR-190)"
   ]
  },
  {
   "dot": "cyan",
   "title": "Unchanged rules",
   "items": [
    "Dependencies still point inward; compose still builds every concrete type",
    "The scheduler goroutine stays the only writer"
   ]
  },
  {
   "dot": "slate",
   "title": "Evidence",
   "items": [
    "Existing components cite commit c27bd1512 (local-only); new ones are target design without sources",
    "The ADRs and the gap analysis are uncommitted (docs/adr, .agents/gaps)",
    "Compare with system-architecture in architecture-delta.html"
   ]
  }
 ]
