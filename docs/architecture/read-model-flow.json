 "cards": [
  {
   "dot": "cyan",
   "title": "One rebuild per state",
   "items": [
    "World() and Snapshot() keep their last result until the tick or viewGen changes",
    "Step and ApplyPending bump viewGen, so every Draw between two ticks shares one rebuild",
    "The renderer turns the cache on; other callers get a fresh rebuild"
   ]
  },
  {
   "dot": "violet",
   "title": "Read only",
   "items": [
    "The renderer sees the game only through its consumer-owned ports",
    "Read models are values: the UI cannot reach into a store"
   ]
  },
