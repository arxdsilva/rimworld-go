 "cards": [
  {
   "dot": "cyan",
   "title": "Order",
   "items": [
    "DrawArt draws layers 1 to 18 into one target (dst), in a fixed order",
    "Numbers follow the GAR render inventory; the tier picks live tiles or chunk bakes",
    "Crops are batched but flushed before any non-plant object, so they split the object run"
   ]
  },
  {
   "dot": "rose",
   "title": "Where draws multiply",
   "items": [
    "Live ground and water issue one draw per visible tile; fog one per chunk",
    "Each lit draw syncs its uniforms first",
    "Weather adds up to three full-screen fills at the backing resolution"
   ]
  },
  {
   "dot": "slate",
   "title": "Evidence",
   "items": [
